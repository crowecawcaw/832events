BEGIN:VEVENT
IMAGE;VALUE=URI;DISPLAY=BADGE;FMTTYPE=image/jpeg:https://iondistrict.com/wp
 -content/uploads/2024/12/DSC_8090-scaled.jpg?ver=1747613455
ATTACH;FMTTYPE=image/jpeg:https://iondistrict.com/wp-content/uploads/2024/1
