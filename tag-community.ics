BEGIN:VEVENT
IMAGE;VALUE=URI;DISPLAY=BADGE;FMTTYPE=image/avif:https://iondistrict.com/wp
 -content/uploads/2025/02/Wade-Houston-Startup-Speedrun.avif?ver=1741041257
