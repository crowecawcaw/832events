parkhouston.org\/events\/slow-flow-with-stephanie-mccarrey-3-2\/2026-07-22\/#primaryimage","url":"https:\/\/www.levyparkhouston.org\/wp-content\/uploads\/2025\/03\/Screenshot-2025-03-04-160746.jpg","contentUrl":"https:\/\/www.levyparkhouston.org\/wp-content\/uploads\/2025\/03\/Screenshot-2025-03-04-160746.jpg","width":1397,"height":1088},"url":"https:\/\/www.levyparkhouston.org\/events\/slow-flow-with-stephanie-mccarrey-3-2\/2026-07-22\/","eventAttendanceMode":"https:\/\/schema.org\/OfflineEventAttendanceMode","eventStatus":"https:\/\/schema.org\/EventScheduled","startDate":"2026-07-22T19:00:00-05:00","endDate":"2026-07-22T20:00:00-05:00","@id":"https:\/\/www.levyparkhouston.org\/events\/slow-flow-with-stephanie-mccarrey-3-2\/2026-07-22\/#event"},{"@type":"Event","name":"Children’s Bingo","description":"Bring the kiddos and join our Levy Park team for Children’s Bingo! This 30-minute program, ideal for kids aged 4 to 12, is a fun way for children to practice their letters and numbers while earning prizes. Levy Park provides Bingo cards, markers, and prizes. B-I-N-G-O!","image":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/www.levyparkhouston.org\/events\/childrens-bingo\/2026-07-23\/#primaryimage","url":"https:\/\/www.levyparkhouston.org\/wp-content\/uploads\/2025\/02\/DSC09097.jpg","contentUrl":"https:\/\/www.levyparkhouston.org\/wp-content\/uploads\/2025\/02\/DSC09097.jpg","width":2048,"height":1366},"url":"https:\/\/www.levyparkhouston.org\/events\/childrens-bingo\/2026-07-23\/","eventAttendanceMode":"https:\/\/schema.org\/OfflineEventAttendanceMode","eventStatus":"https:\/\/schema.org\/EventScheduled","startDate":"2026-07-23T16:30:00-05:00","endDate":"2026-07-23T17:00:00-05:00","@id":"https:\/\/www.levyparkhouston.org\/events\/childrens-bingo\/2026-07-23\/#event"},{"@type":"Event","name":"Blue Dragon Tai Chi","description":"Join us at Levy Park with Taoist Healing for Tai Chi and Meditation every Friday at 9 AM and every Thursday 6 PM. Practice Ta