ww.levyparkhouston.org\/wp-content\/uploads\/2024\/02\/I63A9696.jpg","width":2048,"height":1366},"url":"https:\/\/www.levyparkhouston.org\/events\/zumba-by-tiny-fitness\/2026-07-27\/","eventAttendanceMode":"https:\/\/schema.org\/OfflineEventAttendanceMode","eventStatus":"https:\/\/schema.org\/EventScheduled","startDate":"2026-07-27T18:30:00-05:00","endDate":"2026-07-27T19:30:00-05:00","location":{"@type":"Place","name":"Levy Park (Event Pavilion)","description":"","url":"https:\/\/www.levyparkhouston.org\/venue\/levy-park-event-pavilion\/","address":{"@type":"PostalAddress","addressRegion":"TX"},"telephone":"","sameAs":""},"organizer":{"@type":"Person","name":"Tiny Fitness","description":"","url":"https:\/\/tinyfitnesshouston.com\/","telephone":"(832) 730-3048","email":"&#105;nf&#111;&#64;t&#105;&#110;y&#102;itne&#115;&#115;&#104;o&#117;&#115;t&#111;n.com"},"@id":"https:\/\/www.levyparkhouston.org\/events\/zumba-by-tiny-fitness\/2026-07-27\/#event"},{"@type":"Event","name":"Family Storytime &#038; Craft","description":"Join us for a cross-generational literacy experience! Family Storytime features a story followed by a craft that accompanies the reading. All craft supplies are included as a part of this free program.","image":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/www.levyparkhouston.org\/events\/family-storytime-craft-3\/2026-07-28\/#primaryimage","url":"https:\/\/www.levyparkhouston.org\/wp-content\/uploads\/2024\/03\/R7407885.jpg","contentUrl":"https:\/\/www.levyparkhouston.org\/wp-content\/uploads\/2024\/03\/R7407885.jpg","width":2048,"height":1365},"url":"https:\/\/www.levyparkhouston.org\/events\/family-storytime-craft-3\/2026-07-28\/","eventAttendanceMode":"https:\/\/schema.org\/OfflineEventAttendanceMode","eventStatus":"https:\/\/schema.org\/EventScheduled","startDate":"2026-07-28T10:00:00-05:00","endDate":"2026-07-28T22:30:00-05:00","location":{"@type":"Place","name":"Levy Park (Event Pavilion)","description":"","url":"https:\/\/www.levyparkhouston.org\/venue\/levy-park-event-pavilion\/","address":{"@type":"PostalAddress","addressRegion":"TX"},"telephone":"","sameAs":""},"@id":"https:\/\/www.levyparkhouston.org\/events\/family-storytime-craft-3\/2026-07-28\/#event"},{"@type":"Event","name":"Bollywood &#038; Bhangra Dance","description":"This vibrant and entertaining fitness dance class is suitable for all ability levels. It gives a whole-body workout while dancing to the rhythm of joy with the powerful nature of Bollywood and Bhangra Music.","image":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/www.levyparkhouston.org\/events\/bollywood-bhangra-dance-2-2-4-2\/2026-07-29\/#primaryimage","url":"https:\/\/www.levyparkhouston.org\/wp-content\/uploads\/2024\/08\/DSC0443_DxO.jpg","contentUrl":"https:\/\/www.levyparkhouston.org\/wp-content\/uploads\/2024\/08\/DSC0443_DxO.jpg","width":2048,"height":1366},"url":"https:\/\/www.levyparkhouston.org\/events\/bollywood-bhangra-dance-2-2-4-2\/2026-07-29\/","eventAttendanceMode":"https:\/\/schema.org\/OfflineEventAttendanceMode","eventStatus":"https:\/\/schema.org\/EventScheduled","startDate":"2026-07-29T18:00:00-05:00","endDate":"2026-07-29T19:00:00-05:00","location":{"@type":"Place","name":"Levy Park (Event Pavilion)","description":"","url":"https:\/\/www.levyparkhouston.org\/venue\/levy-park-event-pavilion\/","address":{"@type":"PostalAddress","addressRegion":"TX"},"telephone":"","sameAs":""},"@id":"https:\/\/www.levyparkhouston.org\/events\/bollywood-bhangra-dance-2-2-4-2\/2026-07-29\/#event"},{"@type":"Event","name":"Slow Flow with Stephanie McCarrey","description":"This is an all-levels yoga flow for beginners to experts that will help you build strength and mobility. The vinyasa flow is set to the beat of the latest top 40 and throwback favorites. The last portion of class will be all about opening the body and increasing mobility.  Each class will end with a [&hellip;]","image":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/www.levyparkhouston.org\/events\/slow-flow-with-stephanie-mccarrey-3-2\/2026-07-29\/#primaryimage","url":"https:\/\/www.levyparkhouston.org\/wp-content\/uploads\/2025\/03\/Screenshot-2025-03-04-160746.jpg","contentUrl":"https:\/\/www.levyparkhouston.org\/wp-content\/uploads\/2025\/03\/Screenshot-2025-03-04-160746.jpg","width":1397,"height":1088},"url":"https:\/\/www.levyparkhouston.org\/events\/slow-flow-with-stephanie-mccarrey-3-2\/2026-07-29\/","eventAttendanceMode":"https:\/\/schema.org\/OfflineEventAttendanceMode","eventStatus":"https:\/\/schema.org\/EventScheduled","startDate":"2026-07-29T19:00:00-05:00","endDate":"2026-07-29T20:00:00-05:00","@id":"https:\/\/www.levyparkhouston.org\/events\/slow-flow-with-stephanie-mccarrey-3-2\/2026-07-29\/#event"},{"@type":"Event","name":"Children’s Bingo","description":"Bring the kiddos and join our Levy Park team for Children’s Bingo! This 30-minute program, ideal for kids aged 4 to 12, is a fun way for children to practice their letters and numbers while earning prizes. Levy Park provides Bingo cards, markers, and prizes. B-I-N-G-O!","image":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/www.levyparkhouston.org\/events\/childrens-bingo\/2026-07-30\/#primaryimage","url":"https:\/\/www.levyparkhouston.org\/wp-content\/uploads\/2025\/02\/DSC09097.jpg","contentUrl":"https:\/\/www.levyparkhouston.org\/wp-content\/uploads\/2025\/02\/DSC09097.jpg","width":2048,"height":1366},"url":"https:\/\/www.levyparkhouston.org\/events\/childrens-bingo\/2026-07-30\/","eventAttendanceMode":"https:\/\/schema.org\/OfflineEventAttendanceMode","eventStatus":"https:\/\/schema.org\/EventScheduled","startDate":"2026-07-30T16:30:00-05:00","endDate":"2026-07-30T17:00:00-05:00","@id":"https:\/\/www.levyparkhouston.org\/events\/childrens-bingo\/2026-07-30\/#event"},{"@type":"Event","name":"Blue Dragon Tai Chi","description":"Join us at Levy Park with Taoist Healing for Tai Chi and Meditation every Friday at 9 AM and every Thursday 6 PM. Practice Tai Chi to connect and focus the body and mind with slow, low-impact gentle movements and stretches. Open to all ages and levels, this class is great for those who want to de-stress, find their inner peace, and increase overall health.","image":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/www.levyparkhouston.org\/events\/blue-dragon-tai-chi-2-3\/2026-07-30\/#primaryimage","url":"https:\/\/www.levyparkhouston.org\/wp-content\/uploads\/2023\/11\/2021-09-24_tai_chi_and_swords_-_1964.jpeg","contentUrl":"https:\/\/www.levyparkhouston.org\/wp-content\/uploads\/2023\/11\/2021-09-24_tai_chi_and_swords_-_1964.jpeg","width":2048,"height":1365,"caption":"Join us at Levy Park with Taoist Healing for Tai Chi and Meditation every Friday at 9 AM and every Thursday 6 PM."},"url":"https:\/\/www.levyparkhouston.org\/events\/blue-dragon-tai-chi-2-3\/2026-07-30\/","eventAttendanceMode":"https:\/\/schema.org\/OfflineEventAttendanceMode","eventStatus":"https:\/\/schema.org\/EventScheduled","startDate":"2026-07-30T18:00:00-05:00","endDate":"2026-07-30T19:00:00-05:00","location":{"@type":"Place","name":"Levy Park (Event Pavilion)","description":"","url":"https:\/\/www.levyparkhouston.org\/venue\/levy-park-event-pavilion\/","address":{"@type":"PostalAddress","addressRegion":"TX"},"telephone":"","sameAs":""},"@id":"https:\/\/www.levyparkhouston.org\/events\/blue-dragon-tai-chi-2-3\/2026-07-30\/#event"},{"@type":"Event","name":"Blue Dragon Tai Chi","description":"Join us at Levy Park with Taoist Healing for Tai Chi and Meditation every Thursday at 7 pm and Friday at 9 am. Practice Tai Chi to connect and focus the body and mind with slow, low-impact gentle movements and stretches. Open to all ages and levels, this class is great for those who want to de-stress, find their inner peace, and increase overall health. ","image":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/www.levyparkhouston.org\/events\/blue-dragon-tai-chi-2-2\/2026-07-31\/#primaryimage","url":"https:\/\/www.levyparkhouston.org\/wp-content\/uploads\/2023\/11\/2021-09-24_tai_chi_and_swords_-_1964.jpeg","contentUrl":"https:\/\/www.levyparkhouston.org\/wp-content\/uploads\/2023\/11\/2021-09-24_tai_chi_and_swords_-_1964.jpeg","width":2048,"height":1365,"caption":"Join us at Levy Park with Taoist Healing for Tai Chi and Meditation every Friday at 9 AM and every Thursday 6 PM."},"url":"https:\/\/www.levyparkhouston.org\/events\/blue-dragon-tai-chi-2-2\/2026-07-31\/","eventAttendanceMode":"https:\/\/schema.org\/OfflineEventAttendanceMode","eventStatus":"https:\/\/schema.org\/EventScheduled","startDate":"2026-07-31T09:00:00-05:00","endDate":"2026-07-31T10:00:00-05:00","location":{"@type":"Place","name":"Levy Park (Event Pavilion)","description":"","url":"https:\/\/www.levyparkhouston.org\/venue\/levy-park-event-pavilion\/","address":{"@type":"PostalAddress","addressRegion":"TX"},"telephone":"","sameAs":""},"@id":"https:\/\/www.levyparkhouston.org\/events\/blue-dragon-tai-chi-2-2\/2026-07-31\/#event"}]}</script>
