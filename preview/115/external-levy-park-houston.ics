        mutations.forEach(function() {
            var elements = document.querySelectorAll(".swiper-pagination.swiper-pagination-fraction");

            elements.forEach(function(el) {
                el.classList.add("swiper-pagination-horizontal");
            });
        });
    });

    observer.observe(document.body, { childList: true, subtree: true });
});
	
document.addEventListener("DOMContentLoaded", function () {
    function updateClasses() {
        document.querySelectorAll(".swiper.elementor-loop-container.elementor-grid.swiper-container-initialized.swiper-container-horizontal")
            .forEach(function (el) {
                el.classList.remove("swiper-container-initialized", "swiper-container-horizontal");
                el.classList.add("swiper-initialized", "swiper-horizontal", "swiper-pointer-events");
            });
    }

    // Run immediately in case the element is already in the DOM
    updateClasses();

    // Observe the DOM for future changes
    var observer = new MutationObserver(updateClasses);
    observer.observe(document.body, { childList: true, subtree: true });
});



</script>
