	t\n			\n				\n				\n				\n				\n				Wednesday\, Oct 14\, 7:30 p.m. \n			\
	n				\n				\n				\n				\n				Thursday\, Oct 15\, 7:30 p.m. — Out@TUTS Aft
	erparty\n			\n				\n				\n				\n				\n				Friday\, Oct 16\, 8 p.m. \n			\
