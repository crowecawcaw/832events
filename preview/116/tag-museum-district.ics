BEGIN:VEVENT
IMAGE;VALUE=URI;DISPLAY=BADGE;FMTTYPE=image/jpeg:https://hermannpark.org/wp
 -content/uploads/2026/07/HP_PTP_2025_Digital_1080x1080-e1784305129178.jpg
