GEO:29.7191812;-95.3886681
X-APPLE-STRUCTURED-LOCATION;VALUE=URI;X-ADDRESS=Miller Outdoor Theatre 6000 Hermann Park Dr Houston TX 77030 United States;X-APPLE-RADIUS=500;X-TITLE=6000 Hermann Park Dr:geo:-95.3886681,29.7191812
END:VEVENT
