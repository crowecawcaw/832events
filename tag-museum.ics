BEGIN:VEVENT
IMAGE;VALUE=URI;DISPLAY=BADGE;FMTTYPE=image/png:https://houstonmaritime.org
 /wp-content/uploads/Updated-OSW-Drinks-2026-Houston-940-x-788-px.png
ATTACH;FMTTYPE=image/png:https://houstonmaritime.org/wp-content/uploads/Upd
