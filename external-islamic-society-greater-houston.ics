<link rel="stylesheet" type="text/css" media="all" href="https://isgh.org/?custom-page=header-custom-css&amp;current_page_id=20"/><style id="wp-custom-css">
.page p {line-height: 1.85em;}

.button {font-weight: bold;}

.p-text {font-size:20px;}

.p-text2 {font-size:145%;}

.hijri-date { 
font-size:18px; 
} 

.small-text {
font-size:13px;}

.khutbah {width:106%;}

.kindful-donate-btn {width:100%;
	text:bold;

}

.mybutton {
background-color: #6ab165;
border-radius: 4px;
color: #fdfefe;
padding: 8px;
text-align: center;
font-size: 22px;
margin-bottom: 0px; 
}

.online-giving-button {color: #DDCBA5;}

.volunteer-button {color: #52E1DD;}

.membership-button {color: #F6E154;}

.about-button {color: white;}

.centers-social-font {font-size:14px;}
</style>
